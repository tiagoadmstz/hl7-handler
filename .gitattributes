# Auto detect text files and normalize line endings to LF
* text=auto

# Java files
*.java text eol=lf
*.class binary
*.jar binary

# Maven
pom.xml text eol=lf
target/ export-ignore

# YAML
*.yaml text eol=lf
*.yml text eol=lf

# JSON
*.json text eol=lf

# Markdown
*.md text eol=lf

# Shell scripts
*.sh text eol=lf

# Windows shell scripts
*.bat text eol=crlf
*.cmd text eol=crlf

# Git
.gitignore text eol=lf
.gitattributes text eol=lf

# Compiled files
*.o binary
*.a binary
*.so binary
*.exe binary
*.dll binary
